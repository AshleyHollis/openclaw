+export type PublishDirectoryNoReplaceOptions = Readonly<{
+    stagedDir: string;
+    targetDir: string;
+    /** The durable identity captured before publication, not a fresh observation. */
+    expectedIdentity: Readonly<{
+        dev: bigint;
+        ino: bigint;
+    }>;
+    assertBeforeMutation?: () => void;
+}>;
+export type PublishDirectoryNoReplaceReceipt = Readonly<{
+    status: "published";
+    targetDir: string;
+    identity: Readonly<{
+        dev: bigint;
+        ino: bigint;
+    }>;
+}>;
+/** Publish a previously prepared sibling directory without replacing any target. */
+export declare function publishDirectoryNoReplace(options: PublishDirectoryNoReplaceOptions): PublishDirectoryNoReplaceReceipt;
