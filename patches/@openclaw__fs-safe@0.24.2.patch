+import fs from "node:fs";
+import path from "node:path";
+import { inspectDirectoryIdentitySync } from "./directory-guard.js";
+import { FsSafeError } from "./errors.js";
+import { requireNativeBinding } from "./native.js";
+import { assertSynchronousCallbackResult } from "./mutation-authority.js";
+import { admitStandalonePublicationPath } from "./windows-path-alias.js";
+function basename(value) {
+    const name = path.basename(value);
+    if (!name || name === "." || name === ".." || name.includes("\0")) {
+        throw new FsSafeError("invalid-path", "directory publication requires one basename");
+    }
+    return name;
+}
+/** Publish a previously prepared sibling directory without replacing any target. */
+export function publishDirectoryNoReplace(options) {
+    if (process.platform !== "linux" && process.platform !== "darwin") {
+        throw new FsSafeError("unsupported-platform", "native directory publication requires Linux or macOS");
+    }
+    const stagedDir = path.resolve(admitStandalonePublicationPath(options.stagedDir));
+    const targetDir = path.resolve(admitStandalonePublicationPath(options.targetDir));
+    const parent = path.dirname(stagedDir);
+    if (parent !== path.dirname(targetDir) || stagedDir === targetDir) {
+        throw new FsSafeError("invalid-path", "directory publication requires distinct sibling paths");
+    }
+    const stagedName = basename(stagedDir);
+    const targetName = basename(targetDir);
+    const expected = options.expectedIdentity;
+    if (typeof expected?.dev !== "bigint" || typeof expected.ino !== "bigint" ||
+        expected.dev < 0n || expected.ino < 0n ||
+        (options.assertBeforeMutation !== undefined && typeof options.assertBeforeMutation !== "function")) {
+        throw new FsSafeError("invalid-path", "directory publication requires an exact identity and synchronous guard");
+    }
+    const binding = requireNativeBinding();
+    if (typeof binding.renameNoReplaceWithIdentity !== "function") {
+        throw new FsSafeError("helper-unavailable", "directory publication requires native identity-aware rename");
+    }
+    const parentFd = fs.openSync(parent, fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW);
+    let published = false;
+    let operationError;
+    try {
+        const held = fs.fstatSync(parentFd, { bigint: true });
+        inspectDirectoryIdentitySync(parent, held);
+        inspectDirectoryIdentitySync(stagedDir, expected);
+        assertSynchronousCallbackResult(options.assertBeforeMutation?.(), "assertBeforeMutation");
+        // No await occurs between the last identity check and native publication.
+        inspectDirectoryIdentitySync(parent, held);
+        inspectDirectoryIdentitySync(stagedDir, expected);
+        try {
+            binding.renameNoReplaceWithIdentity(parentFd, stagedName, parentFd, targetName, expected.dev, expected.ino);
+        }
+        catch (error) {
+            const code = error?.code;
+            if (code === "EEXIST" || code === "ENOTEMPTY") {
+                throw new FsSafeError("already-exists", "directory publication target exists", { cause: error });
+            }
+            throw error;
+        }
+        published = true;
+        inspectDirectoryIdentitySync(targetDir, expected);
+        inspectDirectoryIdentitySync(parent, held);
+        fs.fsyncSync(parentFd);
+        return Object.freeze({ status: "published", targetDir, identity: Object.freeze({ ...expected }) });
+    }
+    catch (error) {
+        operationError = error;
+        if (published) {
+            throw new FsSafeError("helper-failed", "directory was published but final verification or sync failed", {
+                cause: error, details: { publication: "published" },
+            });
+        }
+        throw error;
+    }
+    finally {
+        try {
+            fs.closeSync(parentFd);
+        }
+        catch (error) {
+            if (published) {
+                throw new FsSafeError("helper-failed", "directory was published but parent close failed", {
+                    cause: operationError ? new AggregateError([operationError, error]) : error,
+                    details: { publication: "published" },
+                });
+            }
+            if (operationError)
+                throw new AggregateError([operationError, error], "directory publication and parent close failed");
+            throw error;
+        }
+    }
+}
